# MkAIHub local development configuration.
# Copy this file to .env and replace APP_SECRET_KEY with a random value.
# Do not commit the copied .env file, initial passwords, or production data.

APP_ENV=development
APP_NAME=MkAIHub
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# These relative paths assume backend commands are run from the backend/ directory.
DATABASE_URL=sqlite:///../data/mkaihub.sqlite3
DATA_DIR=../data
UPLOAD_DIR=../storage/uploads

MAX_UPLOAD_SIZE_MB=50
MAX_ATTACHMENTS_PER_ARTIFACT=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,pptx,md,txt,csv,json,png,jpg,jpeg,webp,py,js,ts,vue,sql,yaml,yml,toml,ipynb,zip

SESSION_COOKIE_NAME=mkaihub_session
SESSION_TTL_HOURS=24
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
# Suggested username only. The application never auto-creates an account;
# run `uv run python -m app.cli create-admin` after applying migrations.
INITIAL_ADMIN_USERNAME=admin

# Optional deployment setting; Docker Compose defaults to 8000 when omitted.
# APP_PORT=8000
